<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c"/>
		<include src="file://{resources}/styles/custom_game/xhs_theme.css"/>
		<include src="file://{resources}/layout/custom_game/ingame_advertize/ingame_advertize.css"/>
	</styles>

	<scripts>
		<include src="file://{resources}/layout/custom_game/ingame_advertize/ingame_advertize.js"/>
	</scripts>

	<Panel class="Ads_Root" hittest="true">
		<Panel class="Ads_Backdrop" hittest="false"/>

		<Panel class="Ads_HeaderRow">
			<Panel class="Ads_TitleBlock">
				<Label class="Ads_Eyebrow" hittest="false" text="X HERO SIEGE"/>
				<Label id="Ads_Header" hittest="false" text="#ingame_advertize_header"/>
			</Panel>

			<Button id="Ads_CloseButton" onactivate="CloseFixGame()">
				<Label text="X"/>
			</Button>
		</Panel>

		<Panel id="Ads_MainText">
			<Panel class="Ads_StatCard">
				<Label class="Ads_StatValue" text="{s:player_count_monthly}+"/>
				<Label class="Ads_StatLabel" text="monthly players"/>
			</Panel>

			<Panel class="Ads_Copy">
				<Label id="Ads_Description" hittest="false" html="true" text="#ingame_advertize_description"/>
			</Panel>
		</Panel>

		<Panel class="Ads_QuickFacts">
			<Panel class="Ads_Fact">
				<Panel class="Ads_FactDot"/>
				<Label text="Find teammates"/>
			</Panel>
			<Panel class="Ads_Fact">
				<Panel class="Ads_FactDot"/>
				<Label text="Patch news"/>
			</Panel>
			<Panel class="Ads_Fact">
				<Panel class="Ads_FactDot"/>
				<Label text="Builds & strategy"/>
			</Panel>
		</Panel>

		<Panel id="Ads_Footer">
			<DOTASettingsCheckbox id="Ads_DoNotShowAgain" class="Ads_Checkbox" onactivate="OnAdsDoNotShowToggle()">
				<Label text="Don't show next time"/>
			</DOTASettingsCheckbox>

			<Button class="Ads_Button Ads_ButtonSecondary" id="Ads_More" onactivate="OpenAdsWebsite()">
				<Label class="FixCH_ButtonText" text="#ingame_advertize_more"/>
			</Button>

			<Button class="Ads_Button Ads_ButtonDiscord" id="Ads_More2" onactivate="OpenAdsDiscord()">
				<Label class="FixCH_ButtonText" text="#ingame_advertize_more2"/>
			</Button>

			<Button class="Ads_Button Ads_ButtonGhost" id="Ads_Dismiss" onactivate="CloseFixGame()">
				<Label class="FixCH_ButtonText" text="#ingame_advertize_dismiss"/>
			</Button>
		</Panel>
	</Panel>
</root>
