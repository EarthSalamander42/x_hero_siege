<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/xhs_theme.css" />
		<include src="file://{resources}/styles/custom_game/xhs_notifications.css" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/custom_game/xhs_notifications.js" />
	</scripts>

	<Panel class="XHSNotificationsRoot" hittest="false">
		<Panel id="XHSRewardFlyoutLayer" class="XHSRewardFlyoutLayer" hittest="false" />

		<Panel id="XHSWaveCountdown" hittest="false" class="XHSWaveCountdown XHSNotificationHidden">
			<Panel class="XHSWaveRingWrap">
				<Panel class="XHSWaveRing" />
				<Panel id="XHSWaveRingFill" class="XHSWaveRingFill" />
				<Panel id="XHSWaveRingSweep" class="XHSWaveRingSweep" />
				<Label id="XHSWaveCountdownValue" class="XHSWaveCountdownValue" text="30" />
			</Panel>
			<Panel class="XHSWaveCopy">
				<Label id="XHSWaveEyebrow" class="XHSWaveEyebrow" text="WAVE INCOMING" />
				<Label id="XHSWaveTitle" class="XHSWaveTitle" text="Wave of Darkness" />
				<Label id="XHSWaveSubtitle" class="XHSWaveSubtitle" text="Prepare your lane" />
			</Panel>
		</Panel>

		<Panel id="XHSRuneIndicator" hittest="false" class="XHSRuneIndicator XHSRuneHidden">
			<Panel id="XHSRuneAccent" class="XHSRuneAccent" />
			<Panel class="XHSRuneBody">
				<Panel class="XHSRuneHeader">
					<Panel class="XHSRuneCopy">
						<Label id="XHSRuneEyebrow" class="XHSRuneEyebrow" text="RUNE ACTIVE" />
						<Label id="XHSRuneName" class="XHSRuneName" text="" />
						<Label id="XHSRuneDetail" class="XHSRuneDetail" text="" />
					</Panel>
					<Label id="XHSRuneCount" class="XHSRuneCount" text="1/1" />
				</Panel>
				<Panel id="XHSRunePips" class="XHSRunePips">
					<Panel id="XHSRunePip0" class="XHSRunePip" />
					<Panel id="XHSRunePip1" class="XHSRunePip" />
					<Panel id="XHSRunePip2" class="XHSRunePip" />
					<Panel id="XHSRunePip3" class="XHSRunePip" />
				</Panel>
			</Panel>
		</Panel>

		<Panel id="XHSTopNotifications" hittest="false" class="XHSNotificationStack XHSTopNotifications" />
		<Panel id="XHSBottomNotifications" hittest="false" class="XHSNotificationStack XHSBottomNotifications" />
	</Panel>
</root>
