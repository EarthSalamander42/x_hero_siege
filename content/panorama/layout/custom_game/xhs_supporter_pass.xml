									<Button id="XHSPassPurchaseConfirmSubmit" class="XHSPassPurchaseConfirmSubmit"><Label text="#xhs_sp_confirm_purchase" /></Button>
								</Panel>
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassArmoryPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader HasFilters XHSPassArmoryHeader">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_armory" />
