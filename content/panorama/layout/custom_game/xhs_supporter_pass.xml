								<Button id="XHSPassAchievementFilterComplete" class="XHSPassAchievementFilter"><Label text="#xhs_sp_achievement_filter_complete" /></Button>
								<Button id="XHSPassAchievementFilterComing" class="XHSPassAchievementFilter"><Label text="#xhs_sp_achievement_filter_coming" /></Button>
							</Panel>

							<Panel id="XHSPassAchievementsGrid" class="XHSPassAchievementsGrid" />
						</Panel>
					</Panel>

					<Panel id="XHSPassRewardsPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_season_rewards" />
							<Label class="XHSPassSectionNote" text="#xhs_sp_season_rewards_note" />
						</Panel>
						<Panel id="XHSPassRewardTracks" class="XHSPassRewardTracks" />
