<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/xhs_theme.css" />
		<include src="file://{resources}/styles/custom_game/xhs_supporter_pass.css" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/custom_game/util.js" />
		<include src="file://{resources}/scripts/custom_game/xhs_name_display.js" />
		<include src="file://{resources}/scripts/custom_game/generated/xhs_supporter_couriers.js" />
		<include src="file://{resources}/scripts/custom_game/generated/xhs_supporter_effigy_catalog.js" />
		<include src="file://{resources}/scripts/custom_game/xhs_supporter_pass.js" />
	</scripts>

	<Panel class="XHSSupporterPassRoot" hittest="false">
		<Button id="XHSSupporterPassButton" class="XHSSupporterPassButton" hittest="true">
			<Panel class="XHSSupporterPassButtonGlow" hittest="false" ignore-parent-flow="true" />

			<Panel class="XHSSupporterPassButtonContent" hittest="false">
				<Panel class="XHSSupporterPassButtonIcon">
					<Label class="XHSSupporterPassButtonIconText" text="#xhs_sp_title" />
				</Panel>

				<Panel class="XHSSupporterPassButtonCopy">
					<Panel id="XHSSupporterFragmentsCounter" class="XHSSupporterFragmentsCounter" hittest="false">
						<Label class="XHSSupporterFragmentsCounterIcon" text="F" />
						<Label id="XHSSupporterFragmentsCounterValue" class="XHSSupporterFragmentsCounterValue" text="0" />
					</Panel>
				</Panel>
			</Panel>
		</Button>

		<Panel id="XHSSupporterPassWindow" class="XHSSupporterPassWindow" hittest="true">
			<Panel class="XHSPassHeader">
				<Panel class="XHSPassHeaderMedia" hittest="false" ignore-parent-flow="true" />
				<Panel class="XHSPassHeaderVeil" hittest="false" ignore-parent-flow="true" />
				<Panel class="XHSPassHeaderCopy">
					<Panel class="XHSPassHeaderProgressTop">
						<Label id="XHSPassHeaderLevelLabel" class="XHSPassHeaderLevelLabel" text="LEVEL 1" />
						<Panel class="XHSPassHeaderFragmentsInline" hittest="false">
							<Image class="XHSPassFragmentLogo XHSPassFragmentLogoSmall" src="file://{images}/custom_game/battlepass/supporter_fragments_logo.png" />
							<Label id="XHSPassHeaderFragmentsValue" class="XHSPassHeaderFragmentsValue" text="0" />
						</Panel>
					</Panel>
					<Panel class="XHSPassHeaderProgressBar">
						<Panel id="XHSPassHeaderXpProgress" class="XHSPassHeaderProgressFill" />
					</Panel>
					<Label id="XHSPassHeaderXPLabel" class="XHSPassHeaderXPLabel" text="0 / 1000 XP" />
				</Panel>

				<Panel class="XHSPassTopBar">
					<Button id="XHSPassTabOverview" class="XHSPassTab IsActive">
						<Label text="#xhs_sp_tab_overview" />
					</Button>
					<Button id="XHSPassTabRewards" class="XHSPassTab">
						<Label text="#xhs_sp_tab_rewards" />
					</Button>
					<Button id="XHSPassTabShop" class="XHSPassTab">
						<Label text="#xhs_sp_tab_shop" />
					</Button>
					<Button id="XHSPassTabArmory" class="XHSPassTab">
						<Label text="#xhs_sp_tab_armory" />
					</Button>
					<Button id="XHSPassTabSettings" class="XHSPassTab">
						<Label text="#xhs_sp_tab_settings" />
					</Button>
				</Panel>

				<Button id="XHSPassDevUnlockUIButton" class="XHSPassDevUnlockUIButton">
					<Label id="XHSPassDevUnlockUILabel" text="DEV: UNLOCK UI" />
				</Button>

				<Button id="XHSPassDevFreeUIButton" class="XHSPassDevUnlockUIButton XHSPassDevFreeUIButton">
					<Label id="XHSPassDevFreeUILabel" text="DEV: FREE UI" />
				</Button>

				<Panel id="XHSPassHeaderFragmentsWallet" class="XHSPassHeaderFragmentsWallet" hittest="false">
					<Image class="XHSPassFragmentLogo" src="file://{images}/custom_game/battlepass/supporter_fragments_logo.png" />
					<Label id="XHSPassHeaderWalletValue" class="XHSPassHeaderWalletValue" text="0" />
				</Panel>

				<Button id="XHSPassCloseButton" class="XHSPassIconButton">
					<Label text="X" />
				</Button>
			</Panel>

			<Panel class="XHSPassBody">
				<Panel class="XHSPassContent">
					<Panel id="XHSPassOverviewPage" class="XHSPassPage IsVisible">
						<Panel id="XHSPassOverviewGrid" class="XHSPassOverviewGrid">
							<Panel class="XHSPassHeroRow">
								<Panel class="XHSPassProfileCard XHSPanel">
									<Panel class="XHSPassProfileTop">
										<DOTAAvatarImage id="XHSPassAvatar" class="XHSPassAvatar" />
										<Panel class="XHSPassProfileCopy">
											<Label id="XHSPassPlayerName" class="XHSPassProfileName" text="#xhs_sp_player" />
											<Label id="XHSPassPlayerTier" class="XHSPassProfileTier" text="#xhs_sp_free_player" />
										</Panel>
									</Panel>
									<Panel class="XHSPassProgressBlock">
										<Panel class="XHSPassProgressHeader">
											<Label id="XHSPassLevelLabel" text="#xhs_sp_season_level" />
											<Label id="XHSPassXpLabel" text="0 / 2000 XP" />
										</Panel>
										<Panel class="XHSPassProgressBar">
											<Panel id="XHSPassXpProgress" class="XHSPassProgressFill" />
										</Panel>
									</Panel>
								</Panel>

								<Panel class="XHSPassProfileStats">
									<Panel class="XHSPassStatsRow">
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_tier" />
											<Label id="XHSPassTierValue" class="XHSPassHeaderStatValue" text="#xhs_sp_free" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_global_xp" />
											<Label id="XHSPassGlobalXPValue" class="XHSPassHeaderStatValue" text="-" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_supporter_xp" />
											<Label id="XHSPassSeasonXPValue" class="XHSPassHeaderStatValue" text="0 / 1000" />
										</Panel>
									</Panel>
									<Panel class="XHSPassStatsRow">
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_fragments" />
											<Label id="XHSPassFragmentsValue" class="XHSPassHeaderStatValue" text="0" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_daily_cap" />
											<Label id="XHSPassWeeklyCapValue" class="XHSPassHeaderStatValue" text="0 / 100" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_xp_boost" />
											<Label id="XHSPassXPBoostValue" class="XHSPassHeaderStatValue" text="+0%" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="#xhs_sp_vote_power" />
											<Label id="XHSPassVotePowerValue" class="XHSPassHeaderStatValue" text="1 vote" />
										</Panel>
									</Panel>
								</Panel>
							</Panel>

							<Panel class="XHSPassTiersCard XHSPanel">
								<Panel class="XHSPassSectionHeader">
									<Label class="XHSPassSectionTitle" text="#xhs_sp_supporter_tiers" />
									<Label class="XHSPassSectionNote" text="#xhs_sp_supporter_tiers_note" />
								</Panel>
								<Panel id="XHSPassTierRows" class="XHSPassTierRows" />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassRewardsPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_season_rewards" />
							<Label class="XHSPassSectionNote" text="#xhs_sp_season_rewards_note" />
						</Panel>
						<Panel id="XHSPassRewardTracks" class="XHSPassRewardTracks" />
					</Panel>

					<Panel id="XHSPassShopPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader HasFilters">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_fragment_shop" />
							<Panel id="XHSPassShopFilters" class="XHSPassSectionFilterTabs" />
							<Label id="XHSPassShopRefresh" class="XHSPassSectionNote" text="PERMANENT CATALOG" />
						</Panel>
						<Panel class="XHSPassShopDiscoveryBar">
							<TextEntry id="XHSPassShopSearch" class="XHSPassShopSearch" placeholder="Search permanent items..." />
							<Panel class="XHSPassShopFacetGroup">
								<Label class="XHSPassShopFacetLabel" text="EDITION" />
								<Panel id="XHSPassShopEditionFilters" class="XHSPassShopFacetTabs" />
							</Panel>
							<Panel class="XHSPassShopFacetGroup IsRarity">
								<Label class="XHSPassShopFacetLabel" text="RARITY" />
								<Panel id="XHSPassShopRarityFilters" class="XHSPassShopFacetTabs" />
							</Panel>
							<Label id="XHSPassShopCatalogMeta" class="XHSPassShopCatalogMeta" text="" />
						</Panel>
						<Panel id="XHSPassShopHighlights" class="XHSPassShopHighlights">
							<Panel id="XHSPassShopHero" class="XHSPassShopHero" />
							<Panel id="XHSPassShopFeatured" class="XHSPassShopFeatured" />
						</Panel>
						<Panel id="XHSPassShopCatalogHeader" class="XHSPassShopCatalogHeader">
							<Label class="XHSPassShopCatalogTitle" text="PERMANENT COLLECTION" />
							<Label id="XHSPassShopCatalogCount" class="XHSPassShopCatalogCount" text="" />
						</Panel>
						<Panel id="XHSPassShopPager" class="XHSPassPaginationBar" />
						<Panel id="XHSPassShopGrid" class="XHSPassShopGrid" />
						<Panel id="XHSPassShopDetailOverlay" class="XHSPassShopDetailOverlay" hittest="false">
							<Button id="XHSPassShopDetailBackdrop" class="XHSPassShopDetailBackdrop" />
							<Panel class="XHSPassShopDetailWindow">
								<Panel class="XHSPassShopDetailHeader">
									<Panel class="XHSPassShopDetailHeaderCopy">
										<Label class="XHSPassShopDetailEyebrow" text="PERMANENT SUPPORTER ITEM" />
										<Label id="XHSPassShopDetailTitle" class="XHSPassShopDetailTitle" text="" />
									</Panel>
									<Button id="XHSPassShopDetailClose" class="XHSPassShopDetailClose"><Label text="X" /></Button>
								</Panel>
								<Panel id="XHSPassShopDetailBody" class="XHSPassShopDetailBody" />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassArmoryPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader HasFilters XHSPassArmoryHeader">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_armory" />
							<Panel id="XHSPassArmoryFilters" class="XHSPassSectionFilterTabs" />
							<Label class="XHSPassSectionNote" text="#xhs_sp_armory_note" />
						</Panel>
						<Panel id="XHSPassArmoryPager" class="XHSPassPaginationBar" />
						<Panel id="XHSPassArmoryGrid" class="XHSPassShopGrid XHSPassArmoryGrid" />
						<Panel id="XHSPassCourierRequestOverlay" class="XHSPassCourierRequestOverlay" hittest="false">
							<Button id="XHSPassCourierRequestBackdrop" class="XHSPassCourierRequestBackdrop" />
							<Panel class="XHSPassCourierRequestWindow">
								<Panel class="XHSPassCourierRequestWindowHeader">
									<Panel class="XHSPassCourierRequestHeaderCopy">
										<Label class="XHSPassCourierRequestWindowEyebrow" text="FEATURE REQUESTS" />
										<Label id="XHSPassAssetRequestTitle" class="XHSPassCourierRequestTitle" text="#xhs_sp_courier_request_title" />
										<Label id="XHSPassAssetRequestBody" class="XHSPassCourierRequestBody" text="#xhs_sp_courier_request_body" />
									</Panel>
									<Button id="XHSPassCourierRequestCloseButton" class="XHSPassCourierRequestCloseButton">
										<Label text="×" />
									</Button>
								</Panel>
								<Panel id="XHSPassAssetRequestTypeTabs" class="XHSPassAssetRequestTabs IsPrimary" />
								<Panel class="XHSPassAssetRequestBrowseBar">
									<Panel id="XHSPassAssetRequestCategoryTabs" class="XHSPassAssetRequestTabs IsCategory" />
								</Panel>
								<Panel class="XHSPassAssetRequestSearchRow">
									<TextEntry id="XHSPassAssetRequestSearch" class="XHSPassAssetRequestSearch" placeholder="#xhs_sp_request_search" />
								</Panel>
								<Panel id="XHSPassCourierRequestPager" class="XHSPassPaginationBar" />
								<Panel id="XHSPassCourierRequestGrid" class="XHSPassShopGrid XHSPassCourierRequestGrid" />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassSettingsPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="#xhs_sp_settings" />
							<Label class="XHSPassSectionNote" text="#xhs_sp_settings_note" />
						</Panel>
						<Panel id="XHSPassSettingsRows" class="XHSPassSettingsRows" />
						<Panel id="XHSPassSettingsSaveBar" class="XHSPassSettingsSaveBar">
							<Label id="XHSPassSettingsSaveText" class="XHSPassSettingsSaveText" text="#xhs_sp_unsaved_changes" />
							<Button id="XHSPassSettingsCancelButton" class="XHSPassSecondaryButton">
								<Label text="#xhs_sp_cancel" />
							</Button>
							<Button id="XHSPassSettingsSaveButton" class="XHSPassPrimaryButton">
								<Label text="#xhs_sp_save" />
							</Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="XHSPassPremiumCTA" class="XHSPassPremiumCTA" hittest="true">
				<Label class="XHSPassPremiumCTAEyebrow" text="#xhs_sp_premium_cta_eyebrow" />
				<Label class="XHSPassPremiumCTACopy" text="#xhs_sp_premium_cta_copy" />
				<Button id="XHSPassPremiumCTAButton" class="XHSPassPremiumCTAButton">
					<Label text="#xhs_sp_premium_cta_button" />
				</Button>
			</Panel>

			<Panel id="XHSPassActionToast" class="XHSPassActionToast" hittest="false">
				<Label id="XHSPassActionToastText" class="XHSPassActionToastText" text="" />
			</Panel>

			<Button id="XHSPassBackToTopButton" class="XHSPassBackToTopButton">
				<Label text="▲" />
			</Button>
		</Panel>
	</Panel>
</root>
