<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/xhs_theme.css" />
		<include src="file://{resources}/styles/custom_game/xhs_supporter_pass.css" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/custom_game/util.js" />
		<include src="file://{resources}/scripts/custom_game/xhs_supporter_pass.js" />
	</scripts>

	<Panel class="XHSSupporterPassRoot" hittest="false">
		<Button id="XHSSupporterPassButton" class="XHSSupporterPassButton" hittest="true">
			<Panel class="XHSSupporterPassButtonGlow" hittest="false" ignore-parent-flow="true" />

			<Panel class="XHSSupporterPassButtonContent" hittest="false">
				<Panel class="XHSSupporterPassButtonIcon">
					<Label class="XHSSupporterPassButtonIconText" text="Supporter Pass" />
				</Panel>

				<Panel class="XHSSupporterPassButtonCopy">
					<!-- <Label class="XHSSupporterPassButtonText" text="Supporter Pass" /> -->
					<Panel id="XHSSupporterFragmentsCounter" class="XHSSupporterFragmentsCounter" hittest="false">
						<Label class="XHSSupporterFragmentsCounterIcon" text="F" />
						<Label id="XHSSupporterFragmentsCounterValue" class="XHSSupporterFragmentsCounterValue" text="0" />
					</Panel>
				</Panel>
			</Panel>
		</Button>

		<Panel id="XHSSupporterPassWindow" class="XHSSupporterPassWindow" hittest="true">
			<Panel class="XHSPassHeader">
				<Panel class="XHSPassHeaderMedia" hittest="false" ignore-parent-flow="true" />
				<Panel class="XHSPassHeaderVeil" hittest="false" ignore-parent-flow="true" />
				<Panel class="XHSPassHeaderCopy">
					<Label class="XHSPassEyebrow" text="Supporter Pass" />
				</Panel>

				<Panel class="XHSPassTopBar">
					<Button id="XHSPassTabOverview" class="XHSPassTab IsActive">
						<Label text="Overview" />
					</Button>
					<Button id="XHSPassTabRewards" class="XHSPassTab">
						<Label text="Rewards" />
					</Button>
					<Button id="XHSPassTabShop" class="XHSPassTab">
						<Label text="Shop" />
					</Button>
					<Button id="XHSPassTabArmory" class="XHSPassTab">
						<Label text="Armory" />
					</Button>
					<Button id="XHSPassTabLeaderboards" class="XHSPassTab IsDisabled">
						<Label text="Ranking" />
					</Button>
					<Button id="XHSPassTabSettings" class="XHSPassTab">
						<Label text="Settings" />
					</Button>
				</Panel>

				<Button id="XHSPassCloseButton" class="XHSPassIconButton">
					<Label text="X" />
				</Button>
			</Panel>

			<Panel class="XHSPassBody">
				<Panel class="XHSPassContent">
					<Panel id="XHSPassOverviewPage" class="XHSPassPage IsVisible">
						<Panel id="XHSPassOverviewGrid" class="XHSPassOverviewGrid">
							<Panel class="XHSPassHeroRow">
								<Panel class="XHSPassProfileCard XHSPanel">
									<Panel class="XHSPassProfileTop">
										<DOTAAvatarImage id="XHSPassAvatar" class="XHSPassAvatar" />
										<Panel class="XHSPassProfileCopy">
											<Label id="XHSPassPlayerName" class="XHSPassProfileName" text="Player" />
											<Label id="XHSPassPlayerTier" class="XHSPassProfileTier" text="Free Player" />
										</Panel>
									</Panel>
									<Panel class="XHSPassProgressBlock">
										<Panel class="XHSPassProgressHeader">
											<Label id="XHSPassLevelLabel" text="Season Level 1" />
											<Label id="XHSPassXpLabel" text="0 / 2000 XP" />
										</Panel>
										<Panel class="XHSPassProgressBar">
											<Panel id="XHSPassXpProgress" class="XHSPassProgressFill" />
										</Panel>
									</Panel>
								</Panel>

								<Panel class="XHSPassProfileStats">
									<Panel class="XHSPassStatsRow">
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Tier" />
											<Label id="XHSPassTierValue" class="XHSPassHeaderStatValue" text="Free" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Global XP" />
											<Label id="XHSPassGlobalXPValue" class="XHSPassHeaderStatValue" text="-" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Supporter XP" />
											<Label id="XHSPassSeasonXPValue" class="XHSPassHeaderStatValue" text="0 / 1000" />
										</Panel>
									</Panel>
									<Panel class="XHSPassStatsRow">
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Fragments" />
											<Label id="XHSPassFragmentsValue" class="XHSPassHeaderStatValue" text="0" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Daily Cap" />
											<Label id="XHSPassWeeklyCapValue" class="XHSPassHeaderStatValue" text="0 / 100" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="XP Boost" />
											<Label id="XHSPassXPBoostValue" class="XHSPassHeaderStatValue" text="+0%" />
										</Panel>
										<Panel class="XHSPassHeaderStat">
											<Label class="XHSPassHeaderStatLabel" text="Vote Power" />
											<Label id="XHSPassVotePowerValue" class="XHSPassHeaderStatValue" text="1 vote" />
										</Panel>
									</Panel>
								</Panel>
							</Panel>

							<Panel class="XHSPassTiersCard XHSPanel">
								<Panel class="XHSPassSectionHeader">
									<Label class="XHSPassSectionTitle" text="Supporter Tiers" />
									<Label class="XHSPassSectionNote" text="Monthly fragments + identity color + setup vote power" />
								</Panel>
								<Panel id="XHSPassTierRows" class="XHSPassTierRows" />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassRewardsPage" class="XHSPassPage IsComingSoon">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="Season Rewards" />
							<Label class="XHSPassSectionNote" text="Free and supporter tracks" />
						</Panel>
						<Panel id="XHSPassRewardTracks" class="XHSPassRewardTracks" />
						<Panel class="XHSPassComingSoonOverlay" hittest="true" ignore-parent-flow="true">
							<Panel class="XHSPassComingSoonCard" hittest="false">
								<Label class="XHSPassComingSoonEyebrow" text="Available in 4.1" />
								<Label class="XHSPassComingSoonTitle" text="Coming soon" />
								<Label class="XHSPassComingSoonText" text="Supporter Pass rewards will be available in X Hero Siege 4.1." />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassShopPage" class="XHSPassPage IsComingSoon">
						<Panel class="XHSPassSectionHeader HasFilters">
							<Label class="XHSPassSectionTitle" text="Fragment Shop" />
							<Panel id="XHSPassShopFilters" class="XHSPassSectionFilterTabs" />
							<Label id="XHSPassShopRefresh" class="XHSPassSectionNote" text="Featured rotation" />
						</Panel>
						<Panel id="XHSPassShopGrid" class="XHSPassShopGrid" />
						<Panel class="XHSPassComingSoonOverlay" hittest="true" ignore-parent-flow="true">
							<Panel class="XHSPassComingSoonCard" hittest="false">
								<Label class="XHSPassComingSoonEyebrow" text="Available in 4.1" />
								<Label class="XHSPassComingSoonTitle" text="Coming soon" />
								<Label class="XHSPassComingSoonText" text="The Supporter Pass shop will be available in X Hero Siege 4.1." />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassArmoryPage" class="XHSPassPage IsComingSoon">
						<Panel class="XHSPassSectionHeader HasFilters">
							<Label class="XHSPassSectionTitle" text="Armory" />
							<Panel id="XHSPassArmoryFilters" class="XHSPassSectionFilterTabs" />
							<Label class="XHSPassSectionNote" text="Equipped cosmetics" />
						</Panel>
						<Panel id="XHSPassArmoryGrid" class="XHSPassShopGrid XHSPassArmoryGrid" />
						<Panel class="XHSPassComingSoonOverlay" hittest="true" ignore-parent-flow="true">
							<Panel class="XHSPassComingSoonCard" hittest="false">
								<Label class="XHSPassComingSoonEyebrow" text="Available in 4.1" />
								<Label class="XHSPassComingSoonTitle" text="Coming soon" />
								<Label class="XHSPassComingSoonText" text="Supporter Pass armory loadouts will be available in X Hero Siege 4.1." />
							</Panel>
						</Panel>
					</Panel>

					<Panel id="XHSPassLeaderboardsPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="Leaderboards" />
							<Label class="XHSPassSectionNote" text="XP, winrate, Hall of Fame" />
						</Panel>
						<Panel id="XHSPassLeaderboardRows" class="XHSPassLeaderboardRows" />
					</Panel>

					<Panel id="XHSPassSettingsPage" class="XHSPassPage">
						<Panel class="XHSPassSectionHeader">
							<Label class="XHSPassSectionTitle" text="Settings" />
							<Label class="XHSPassSectionNote" text="Visibility and cosmetics" />
						</Panel>
						<Panel id="XHSPassSettingsRows" class="XHSPassSettingsRows" />
						<Panel id="XHSPassSettingsSaveBar" class="XHSPassSettingsSaveBar">
							<Label id="XHSPassSettingsSaveText" class="XHSPassSettingsSaveText" text="Unsaved changes" />
							<Button id="XHSPassSettingsCancelButton" class="XHSPassSecondaryButton">
								<Label text="Cancel" />
							</Button>
							<Button id="XHSPassSettingsSaveButton" class="XHSPassPrimaryButton">
								<Label text="Save" />
							</Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="XHSPassActionToast" class="XHSPassActionToast" hittest="false">
				<Label id="XHSPassActionToastText" class="XHSPassActionToastText" text="" />
			</Panel>

			<Button id="XHSPassBackToTopButton" class="XHSPassBackToTopButton">
				<Label text="▲" />
			</Button>
		</Panel>
	</Panel>
</root>
