									</Panel>
									<Panel class="XHSPassAchievementsSummaryStat">
										<Label class="XHSPassAchievementsSummaryLabel" text="#xhs_sp_achievement_completion" />
										<Label id="XHSPassAchievementCompletion" class="XHSPassAchievementsSummaryValue" text="0 / 0" />
									</Panel>
								</Panel>
							</Panel>

							<Panel class="XHSPassAchievementsToolbar">
